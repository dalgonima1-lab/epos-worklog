{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/play-approval-attention.ps1",
        "matcher": "Shell"
      },
      {
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/play-approval-attention.ps1",
        "matcher": "CallMcpTool"
      },
      {
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/play-approval-attention.ps1",
        "matcher": "Task"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/play-approval-attention.ps1"
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/play-approval-attention.ps1"
      }
    ]
  }
}
