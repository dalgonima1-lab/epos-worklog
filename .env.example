# Google AI Studio에서 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# 선택: gemini-2.0-flash (기본), gemini-1.5-pro 등
# GEMINI_MODEL=gemini-2.0-flash

# 여러 기기 공유 저장소: Firebase 프로젝트 설정 (Storage 없이도 가능)
# Firebase Console > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 선택: Firebase Storage를 만들었을 때만 입력
# 비워두면 작은 사진은 Firestore 문서 안에 저장합니다.
# FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com

# 직원 전용 배포(Vercel 등): true 이면 일일 기록(/daily)만 사용·표시, 팀장·AI 경로 차단
# 팀장용 배포에서는 설정하지 않거나 false
# NEXT_PUBLIC_STAFF_ONLY=true

# Vercel Cron(매주 토요일 자동 주간 분석): 임의의 긴 비밀 문자열
# Vercel 프로젝트 환경변수에 동일 값 설정 후 Redeploy
# CRON_SECRET=your_random_secret_here
